# build artifacts
*.o
*.o.*
*.dpa.o
*.pyc
build/
pcc/build-host/
__pycache__/

# local machine backups (2GB tarballs + host inventories; never for GitHub)
backup/

# bulky raw captures kept out of history
results/*/raw/

# soak logs churn constantly; soak is disabled (no production plans)
results/soak_20260710/*.log
# bulk experiment data (jsonl/perftest logs); runners+analyzers+summaries are tracked
results/*/*_rx.jsonl
results/*/*_tx.jsonl
results/*/*_t0.txt
results/*/*rdma*.log
results/*/*vf[0-9].log
# per-run raw dumps under paper experiments (figures/CSV/scripts/docs are tracked)
paper/*/*/runs/
results/*/*iperf*.json
results/*/*_ctr.txt
results/*/*_a.log
results/*/*_b.log
results/*/*_vpm.csv

# Same bulk rules for the nested layout (data lives in
# results/<experiment>/results/ per the folder convention, one level
# deeper than the patterns above reach - which is how 1.1 GB of raw
# telemetry got tracked once).
results/*/results/*_rx.jsonl
results/*/results/*_tx.jsonl
results/*/results/*_t0.txt
results/*/results/*_arm.txt
results/*/results/*_events.txt
results/*/results/*rdma*.log
results/*/results/*iperf*.json
results/*/results/*_ctr.txt
results/*/results/*_rp.txt
results/*/results/*_ticks.txt
results/*/results/*.journal
tools/tests/results/
results/regression/

# bulky one-off captures (overlay bring-up pcaps, vtune traces)
results/p0_overlay_20260729/
results/vtune_20260729/

# raw run data of the VF-cap verification (distilled summary + runner stay)
results/vf_caps_20260826/results/

# raw data of the Swift bring-up (distilled figures + summary stay)
results/swift_20260827/results/

# validation/: the suite (README, criteria, scenarios, runner, distiller,
# plots) and its DERIVED artefacts (data/ fig/ reports/) are tracked; the
# raw per-run capture is not - it is ~20 MB a run and is reproducible only
# in the sense that the lab state that produced it is gone anyway.
validation/results/
validation/__pycache__/

# bulk raw telemetry the older patterns did not reach (the earlier
# globs assumed a <tag>_tx.jsonl name; the arms carry <arm>_tx_<host>)
results/*/results/*_tx_*.jsonl
results/*/results/*_rx_*.jsonl
results/conf_20260828/
results/step_arms_20260825/results/

# queueing experiment: the raw switch histogram snapshots (one JSON per second
# per arm); the distilled data/ and fig/ are tracked
results/queueing_20260908/results/*/histogram_raw.jsonl
# queueing experiment: ib_write_lat -H dumps every sample (~700k lines a run);
# the distilled CDF is in data/queueing.csv
results/queueing_20260908/results/*/probe.txt
results/fct_20260909/results/*/probe_*.txt
results/headroom_20260909/results/*/probe_*.txt
