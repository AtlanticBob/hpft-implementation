+/* What neither of a vNIC's two classes took: its other unicast (ARP replies,
+ * ICMP), recognised by the vNIC's MAC and handed to its representor without
+ * touching its buckets - the original sent every such packet to its single
+ * vNIC. A miss goes on to the next vNIC's classifiers. With no MAC (the single
+ * Jakiro of the original deployment) the pipe takes everything, as before. */
+static doca_error_t create_other_forward_pipe(struct doca_flow_port *port,
+					      const struct jakiro_inst_cfg *in,
+					      struct doca_flow_pipe *miss_pipe,
+					      struct doca_flow_pipe **pipe,
+					      struct entries_status *status)
+{
+	struct doca_flow_pipe_cfg *pipe_cfg;
+	struct doca_flow_match match_template = {0};
+	struct doca_flow_match match = {0};
+	struct doca_flow_monitor monitor = {0};
+	struct doca_flow_fwd fwd = {0};
+	struct doca_flow_fwd fwd_miss = {0};
+	struct doca_flow_pipe_entry *entry = NULL;
+	doca_error_t result;
+
+	if (in->has_mac) {
+		memset(match_template.outer.eth.dst_mac, 0xff, sizeof(match_template.outer.eth.dst_mac));
+		memcpy(match.outer.eth.dst_mac, in->dst_mac, sizeof(match.outer.eth.dst_mac));
+	}
+	fwd.type = DOCA_FLOW_FWD_PORT;
+	fwd.port_id = in->fwd_port;
+	fwd_miss.type = DOCA_FLOW_FWD_PIPE;
+	fwd_miss.next_pipe = miss_pipe;
+	monitor.counter_type = DOCA_FLOW_RESOURCE_TYPE_NON_SHARED;
+
+	result = doca_flow_pipe_cfg_create(&pipe_cfg, port);
+	if (result != DOCA_SUCCESS)
+		return result;
+	result = set_flow_pipe_cfg(pipe_cfg, inst_name(in, "JAKIRO_OTHER_TO_VNIC"), DOCA_FLOW_PIPE_BASIC, false);
+	if (result != DOCA_SUCCESS)
+		goto destroy_cfg;
+	result = doca_flow_pipe_cfg_set_nr_entries(pipe_cfg, 1);
+	if (result != DOCA_SUCCESS)
+		goto destroy_cfg;
+	result = doca_flow_pipe_cfg_set_match(pipe_cfg, &match_template, NULL);
+	if (result != DOCA_SUCCESS)
+		goto destroy_cfg;
+	result = doca_flow_pipe_cfg_set_monitor(pipe_cfg, &monitor);
+	if (result != DOCA_SUCCESS)
+		goto destroy_cfg;
+	result = doca_flow_pipe_create(pipe_cfg, &fwd, (in->has_mac && miss_pipe != NULL) ? &fwd_miss : NULL, pipe);
+	if (result != DOCA_SUCCESS)
+		goto destroy_cfg;
+	result = doca_flow_pipe_basic_add_entry(0, *pipe, &match, 0, NULL, NULL, NULL, 0, status, &entry);
+	if (result != DOCA_SUCCESS)
+		DOCA_LOG_ERR("Failed to add %s other-forward entry: %s", in->label, doca_error_get_descr(result));
+	else
+		remember_counter(inst_name(in, "classify_other_forward"), entry);
+
+destroy_cfg:
+	doca_flow_pipe_cfg_destroy(pipe_cfg);
+	return result;
+}
