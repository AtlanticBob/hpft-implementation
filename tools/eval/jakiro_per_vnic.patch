+/* Split a comma-separated list into at most max fields of at most len - 1
+ * characters; returns how many there were, or -1 if one does not fit. */
+static int split_list(const char *value, char out[][16], int max)
+{
+	char buf[512];
+	char *save = NULL, *tok;
+	int n = 0;
+
+	if (value == NULL || strlen(value) >= sizeof(buf))
+		return value == NULL ? 0 : -1;
+	strcpy(buf, value);
+	for (tok = strtok_r(buf, ",", &save); tok != NULL; tok = strtok_r(NULL, ",", &save)) {
+		while (*tok == ' ')
+			tok++;
+		if (*tok == '\0')
+			continue;
+		if (n >= max || strlen(tok) >= 16)
+			return -1;
+		strcpy(out[n++], tok);
+	}
+	return n;
+}
+
+static bool parse_mac(const char *s, uint8_t mac[6])
+{
+	unsigned int b[6];
+
+	if (sscanf(s, "%x:%x:%x:%x:%x:%x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6)
+		return false;
+	for (int i = 0; i < 6; i++)
+		mac[i] = (uint8_t)b[i];
+	return true;
+}
